# Copy this file to .env.local and fill in your real values from
# Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — set these in Vercel, never expose with a NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SERVICEM8_APP_ID=your-servicem8-app-id-here
SERVICEM8_APP_SECRET=your-servicem8-app-secret-here
SERVICEM8_REDIRECT_URI=https://your-domain.vercel.app/api/integrations/servicem8/callback
